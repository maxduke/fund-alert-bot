TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_ALLOWED_USER_IDS=
BOT_LANGUAGE=zh-CN
BOT_UID=
BOT_GID=
SQLITE_PATH=/app/data/fund_alert_bot.sqlite3
TZ=Asia/Shanghai
AFTER_CLOSE_CHECK_TIME=17:10
BEFORE_CLOSE_CHECK_TIME=14:50
DCA_REMINDER_TIME=09:30
FUND_NAV_PROCESS_TIME=08:30
AKSHARE_RETRIES=3
AKSHARE_RETRY_DELAY_SECONDS=0.5
AKSHARE_LATEST_LOOKBACK_DAYS=45
# Paid Eastmoney proxy; keep disabled until a valid token is configured.
AKSHARE_PROXY_ENABLED=false
AKSHARE_PROXY_AUTH_TOKEN=
# Keep this low: each proxy retry can consume paid request quota.
AKSHARE_PROXY_RETRY=1
# Reuse identical historical requests within this process for five minutes.
AKSHARE_HISTORY_CACHE_TTL_SECONDS=300
BARK_ENABLED=false
BARK_SERVER_URL=replace-with-bark-server-url
BARK_DEVICE_KEY=replace-with-bark-device-key
NTFY_ENABLED=false
NTFY_SERVER_URL=replace-with-ntfy-server-url
NTFY_TOPIC=replace-with-ntfy-topic
WEBHOOK_ENABLED=false
WEBHOOK_URL=replace-with-webhook-url
